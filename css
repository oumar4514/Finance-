<style>
  #marketCards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin: 20px 0;
  }

  .market-card {
    background: #111827;
    color: white;
    border-radius: 12px;
    padding: 14px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .market-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    margin-bottom: 10px;
  }

  .market-value {
    font-size: 20px;
    font-weight: 700;
  }

  .message {
    display: flex;
    margin: 8px 0;
  }
  .message.user {
    justify-content: flex-end;
  }
  .message.bot {
    justify-content: flex-start;
  }
  .bubble {
    background: #1f2937;
    color: white;
    padding: 12px 14px;
    border-radius: 12px;
    max-width: 80%;
    white-space: pre-line;
  }
  .message.user .bubble {
    background: #2563eb;
  }
  .loading {
    display: flex;
    gap: 5px;
    align-items: center;
    height: 20px;
  }
  .loading span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    animation: pulse 0.8s infinite alternate;
  }
  .loading span:nth-child(2) { animation-delay: 0.2s; }
  .loading span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes pulse {
    from { transform: scale(0.7); opacity: 0.5; }
    to { transform: scale(1); opacity: 1; }
  }
</style>